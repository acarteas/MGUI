<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Left="360" Top="50" MinHeight="0" Width="900" Height="680" TitleText="Declarative Shader Buttons" Padding="10">
    <Window.Styles>
        <Style TargetType="TextBlock"><Setter Property="FontSize" Value="10" /></Style>
        <Style Name="Header" TargetType="TextBlock"><Setter Property="IsBold" Value="True" /><Setter Property="FontSize" Value="14" /></Style>
        <Style TargetType="Separator"><Setter Property="Height" Value="2" /><Setter Property="Background" Value="White * 0.25" /></Style>
        <Style Name="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="195" /><Setter Property="Height" Value="58" /><Setter Property="Padding" Value="10" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="White * 0.45" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="rgb(31,35,39)" Padding="8">
        <StackPanel Orientation="Vertical" Spacing="10">
            <TextBlock StyleNames="Header" Text="Declarative shader-backed action buttons" HorizontalAlignment="Center" />
            <TextBlock Text="{MGBinding ShaderStatusText}" Foreground="{MGBinding ShaderStatusColor}" />
            <TextBlock WrapText="True">The game loads and registers one caller-owned DesktopGL Effect before XAML materialization. Every brush below resolves that same resource, binds standard values, and supplies the complete custom state vector. Parameters unused by a brush mode are explicitly neutral so draw order cannot leak shared Effect state.</TextBlock>
            <Separator />

            <TextBlock StyleNames="Header" Text="Action states" />
            <UniformGrid Columns="4" RowSpacing="8" ColumnSpacing="8">
                <Button StyleNames="ActionButton" ToolTip="A normal shader-backed action">
                    <Button.Border><Border Background="Transparent" BorderBrush="White * 0.45" BorderThickness="1" /></Button.Border>
                    <Button.Background>
                        <EffectFillBrush EffectName="SampleUiEffect" UseStandardParameters="True">
                            <EffectFillBrush.FallbackBrush><SolidFillBrush Color="rgb(48,58,65)" /></EffectFillBrush.FallbackBrush>
                            <EffectParameter Name="AccentColor" Type="Color" Value="rgb(110,158,180)" />
                            <EffectParameter Name="ButtonRole" Type="Float" Value="0" />
                            <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                            <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                        </EffectFillBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image SourceName="ShaderActionIcon" Width="24" Height="24" TextureColor="White"
                               EffectName="SampleUiEffect" UseStandardParameters="True">
                            <EffectParameter Name="AccentColor" Type="Color" Value="rgb(110,158,180)" />
                            <EffectParameter Name="ButtonRole" Type="Float" Value="2" />
                            <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                            <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                        </Image>
                        <TextBlock Text="Normal" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button StyleNames="ActionButton" ToolTip="Hover and hold to inspect standard hover and press parameters">
                    <Button.Border><Border Background="Transparent" BorderBrush="White * 0.55" BorderThickness="1" /></Button.Border>
                    <Button.Background>
                        <EffectFillBrush EffectName="SampleUiEffect" UseStandardParameters="True">
                            <EffectFillBrush.FallbackBrush><SolidFillBrush Color="rgb(34,72,76)" /></EffectFillBrush.FallbackBrush>
                            <EffectParameter Name="AccentColor" Type="Color" Value="rgb(71,214,193)" />
                            <EffectParameter Name="ButtonRole" Type="Float" Value="1" />
                            <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                            <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                        </EffectFillBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Image SourceName="ShaderActionIcon" Width="24" Height="24" /><TextBlock Text="Primary" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <ToggleButton Width="195" Height="58" Padding="10" BorderThickness="1" BorderBrush="White * 0.45" IsChecked="True" ToolTip="Toggle selection drives SelectedAmount">
                    <ToggleButton.Border><Border Background="Transparent" BorderBrush="White * 0.45" BorderThickness="1" /></ToggleButton.Border>
                    <ToggleButton.Background>
                        <EffectFillBrush EffectName="SampleUiEffect" UseStandardParameters="True">
                            <EffectFillBrush.FallbackBrush><SolidFillBrush Color="rgb(53,48,75)" /></EffectFillBrush.FallbackBrush>
                            <EffectParameter Name="AccentColor" Type="Color" Value="rgb(202,144,255)" />
                            <EffectParameter Name="ButtonRole" Type="Float" Value="0" />
                            <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                            <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                        </EffectFillBrush>
                    </ToggleButton.Background>
                    <ToggleButton.SelectedBackground>
                        <EffectFillBrush EffectName="SampleUiEffect" UseStandardParameters="True">
                            <EffectFillBrush.FallbackBrush><SolidFillBrush Color="rgb(91,63,123)" /></EffectFillBrush.FallbackBrush>
                            <EffectParameter Name="AccentColor" Type="Color" Value="rgb(202,144,255)" />
                            <EffectParameter Name="ButtonRole" Type="Float" Value="1" />
                            <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                            <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                        </EffectFillBrush>
                    </ToggleButton.SelectedBackground>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Image SourceName="ShaderActionIcon" Width="24" Height="24" /><TextBlock Text="Selected" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>

                <Button StyleNames="ActionButton" IsEnabled="False" ToolTip="DisabledAmount reduces contrast and saturation">
                    <Button.Border><Border Background="Transparent" BorderBrush="White * 0.25" BorderThickness="1" /></Button.Border>
                    <Button.Background><SolidFillBrush Color="rgb(55,58,61)" /></Button.Background>
                    <Button.DisabledBackground>
                        <EffectFillBrush EffectName="SampleUiEffect" UseStandardParameters="True">
                            <EffectFillBrush.FallbackBrush><SolidFillBrush Color="rgb(55,58,61)" /></EffectFillBrush.FallbackBrush>
                            <EffectParameter Name="AccentColor" Type="Color" Value="rgb(130,137,143)" />
                            <EffectParameter Name="ButtonRole" Type="Float" Value="0" />
                            <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                            <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                        </EffectFillBrush>
                    </Button.DisabledBackground>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Image SourceName="ShaderActionIcon" Width="24" Height="24" /><TextBlock Text="Disabled" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock WrapText="True">Hover and press the first two controls naturally. The selected toggle and disabled button demonstrate primary-state slots. Icons and labels remain ordinary MGUI content; the effect shades only each rectangular background fill.</TextBlock>
            <Separator />

            <TextBlock StyleNames="Header" Text="Effect-backed ornamental nine-slices" />
            <TextBlock WrapText="True">Both frames sample the SpriteBatch-bound source texture and use one whole-element directional treatment across all texture-backed slices. The left center remains texture-backed and receives the effect. The right center is replaced by an InteriorBrush, so it retains its own solid fill and is not shaded by the frame effect.</TextBlock>
            <UniformGrid Columns="2" ColumnSpacing="12">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Texture-backed center" HorizontalAlignment="Center" />
                    <Border Height="150" Padding="30" BorderThickness="0">
                        <Border.Background>
                            <NineSliceFillBrush SourceName="ShaderOrnamentalFrame" SourceMargin="52" TargetMargin="24"
                                                EffectName="SampleUiEffect" UseStandardParameters="True">
                                <EffectParameter Name="AccentColor" Type="Color" Value="White" />
                                <EffectParameter Name="ButtonRole" Type="Float" Value="0" />
                                <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="1,0.65" />
                                <EffectParameter Name="TreatmentStrength" Type="Float" Value="0.75" />
                            </NineSliceFillBrush>
                        </Border.Background>
                        <TextBlock Text="The woven center is sampled and shaded." WrapText="True"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Separate InteriorBrush" HorizontalAlignment="Center" />
                    <Border Height="150" Padding="30" BorderThickness="0">
                        <Border.Background>
                            <NineSliceFillBrush SourceName="ShaderOrnamentalFrame" SourceMargin="52" TargetMargin="24"
                                                EffectName="SampleUiEffect" UseStandardParameters="True">
                                <NineSliceFillBrush.InteriorBrush>
                                    <SolidFillBrush Color="rgb(34,43,52)" />
                                </NineSliceFillBrush.InteriorBrush>
                                <EffectParameter Name="AccentColor" Type="Color" Value="White" />
                                <EffectParameter Name="ButtonRole" Type="Float" Value="0" />
                                <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="1,0.65" />
                                <EffectParameter Name="TreatmentStrength" Type="Float" Value="0.75" />
                            </NineSliceFillBrush>
                        </Border.Background>
                        <TextBlock Text="Only the eight texture-backed frame slices are shaded." WrapText="True"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </UniformGrid>
            <TextBlock WrapText="True">The effect is fill-only: it does not shade the InteriorBrush, these labels, child content, or any element subtree.</TextBlock>
            <Separator />

            <TextBlock StyleNames="Header" Text="Non-shader conventional comparison" />
            <Button Width="240" Height="60" Padding="10" Background="rgb(55,62,68)" BackgroundFocusedColor="White * 0.10"
                    BorderBrush="White * 0.45" BorderThickness="1" HoveredRenderScale="1.04" PressedRenderScale="0.97"
                    PressedContentOffset="1,1" ToolTip="No shader: image tint, render scale, and pressed content offset are standard MGUI features">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image SourceName="ShaderActionIcon" Width="24" Height="24" TextureColor="White"
                           HoveredTextureColor="LightGreen" PressedTextureColor="Goldenrod"
                           SelectedTextureColor="CornflowerBlue" DisabledTextureColor="Gray" />
                    <TextBlock Text="Conventional action" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="Existing desktop/theme tooltip delay, offset, foreground, and normal XAML ToolTip styling are sufficient; no shader-specific tooltip API is needed." WrapText="True" />

            <Separator />
            <TextBlock StyleNames="Header" Text="Focused time example" />
            <Border Width="300" Height="72" Padding="10" BorderBrush="White * 0.35" BorderThickness="1">
                <Border.Background>
                    <EffectFillBrush EffectName="SampleUiEffect" UseStandardParameters="True">
                        <EffectFillBrush.FallbackBrush><SolidFillBrush Color="rgb(39,67,52)" /></EffectFillBrush.FallbackBrush>
                        <EffectParameter Name="AccentColor" Type="Color" Value="rgb(83,222,139)" />
                        <EffectParameter Name="ButtonRole" Type="Float" Value="2" />
                        <EffectParameter Name="TreatmentDirection" Type="Vector2" Value="0,0" />
                        <EffectParameter Name="TreatmentStrength" Type="Float" Value="0" />
                    </EffectFillBrush>
                </Border.Background>
                <TextBlock Text="[b]Attention pulse[/b]\nOnly this example animates with TimeSeconds." WrapText="True" />
            </Border>

            <Separator />
            <TextBlock WrapText="True">This sample's compiled MGFX artifact targets DesktopGL. Vulkan, DirectX, mobile, and other consumers must compile and register backend-compatible effects; MGUI does not promise shader-bytecode portability or own effect lifetime.</TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>
