<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../MGUI.MonoGame.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\MGUI.Shared\MGUI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.4" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" Condition="'$(MGUIUseMonoGameNative)' != 'true'">
      <IncludeAssets>compile; build</IncludeAssets>
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
